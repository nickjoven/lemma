# S2: span-MLM pretraining of the 33M statement encoder.
# corpus_cids / tokenizer_cid are filled from the quod manifest + frozen
# tokenizer before the first real run; the ledger refuses to compare metrics
# across a different (mathlib_pin, tokenizer_cid) pair.
mathlib_pin: "crouzeix:v4.28.0:8f9d9cff"
# corpus version = the source manifest CID (corpus full-20260908b, readable_pp)
corpus_cids: ["c6ad843fb81f6f1e542df40480be3c4b538b7748c9554528b179d708d3ba029c"]
tokenizer_cid: "3b33be812ca5991f454b242b7d6fc05512f582384f7d23792ef64a0944a620d4"
tokenizer_path: runs/tokenizer/lean-unigram-32k.json
cache_dir: corpora/cache
cache_name: declarations-train
seed: 1337
batch_size: 96
steps: 60000
lr: 3.0e-4
compile: false
encoder:
  d_model: 512
  n_layers: 8
  n_heads: 8
  d_ff: 2048
  # readable_pp tokenizes to p50=88 / p99=309 tokens; only 0.17% exceed 512,
  # so seq 512 is comfortable (the pp.all 1024/batch-48 stopgap is retired).
  max_seq: 512
